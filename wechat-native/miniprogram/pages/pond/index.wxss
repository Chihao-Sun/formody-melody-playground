.stage{position:fixed;inset:0;overflow:hidden}.pond{position:absolute;inset:0;width:100%;height:100%}
.header{position:absolute;left:19px;right:19px;display:flex;justify-content:space-between;align-items:center;pointer-events:none;z-index:2}
.brand{font-size:25px;letter-spacing:-1.3px;font-weight:600;text-shadow:0 2px 18px #52445d15}.brand-cn{display:block;font-weight:400;font-size:12px;letter-spacing:4px;margin-top:3px}
.top-actions{display:flex;gap:8px;pointer-events:auto}.round{width:48px;height:48px;min-width:48px;min-height:48px;border-radius:50%;background:#294c6555;border:1px solid #fdf1dc33;display:flex;align-items:center;justify-content:center}.round image{width:27px;height:27px}.sound-icon.is-sounding{animation:record-turn 12s linear infinite}@keyframes record-turn{to{transform:rotate(360deg)}}
.score{position:absolute;left:24px;right:24px;text-align:center;pointer-events:none;font-size:14px;letter-spacing:1px;color:#fffcf2;text-shadow:0 2px 15px #40466a26}.score-dots{display:flex;justify-content:center;gap:8px;margin-top:13px}.dot{width:5px;height:5px;border-radius:50%;background:#ffffff40;box-shadow:0 0 0 1px #ffffff25;transition:background .7s,box-shadow .7s}.dot.filled{background:#fff1c6;box-shadow:0 0 10px #f9c47780}
.hand-info{position:absolute;left:10px;right:10px;text-align:center;pointer-events:none;text-shadow:0 2px 12px #023c524c,0 1px 4px #023c524c;transition:opacity .6s}.stone-name{font-size:14px;letter-spacing:2px;color:#ecf4f0}.stone-name.rare{color:#ffdfa6}.holding .hand-info{opacity:.25}.listening-mode .hand-info{opacity:0}.listening-mode .score{opacity:.75}
.tutorial{position:absolute;top:48%;left:16px;right:16px;text-align:center;pointer-events:none;text-shadow:0 2px 14px #1844534c,0 1px 4px #1844534c;transition:opacity 1.154s ease .193s,transform 1.154s ease .193s}.hint{display:block;font-size:18px;letter-spacing:1px;margin-bottom:12px}.playing .tutorial{opacity:0;transform:translateY(-8px)}.gesture-options{display:flex;justify-content:center;align-items:center;gap:27px;margin:18px auto 0;color:#fff6e5}.gesture-option{display:flex;align-items:center;gap:9px;text-align:left}.gesture-option image{width:43px;height:38px;flex-shrink:0}.gesture-option text{display:block;font-size:13px;letter-spacing:1px}.gesture-option .small{font-size:11px;letter-spacing:2px;margin-top:5px;opacity:.65}
.toast{position:absolute;left:50%;transform:translateX(-50%);max-width:calc(100% - 38px);width:max-content;background:linear-gradient(135deg,#fff5dfed,#e7eeebe6);color:#305465;border:1px solid #fff4d4b3;box-shadow:0 6px 28px #244f641a;padding:12px 20px;border-radius:24px;font-size:14px;letter-spacing:.6px;line-height:1.65;text-align:center;pointer-events:none;z-index:4}.toast.quiet,.toast.guidance{font-size:12px;padding:7px 13px;border:0;background:#294c654d;color:#fff8ec;box-shadow:none}.toast.guidance{font-size:13px;padding:9px 15px;border-radius:20px}
.listening{position:absolute;left:0;right:0;text-align:center;pointer-events:none;text-shadow:0 1px 10px #2051644c;animation:listen-in 1s ease both}.listening-label{display:block;font-size:17px;letter-spacing:4px;margin-bottom:15px}.listening-hint{display:block;font-size:12px;letter-spacing:1px;opacity:.7;margin:-3px 0 16px}.progress{width:130px;height:2px;margin:auto;background:#ffffff35}.progress view{height:100%;background:#fff1ce}.again{pointer-events:auto;min-height:48px;padding:7px 10px;margin:15px auto 0;font-size:13px;letter-spacing:1.3px;color:#355b64;display:inline-flex;animation:seek-reveal 2.5s ease both}.seek-pill{display:flex;align-items:center;justify-content:center;gap:7px;padding:8px 13px;border-radius:22px;background:linear-gradient(135deg,#f8f0dfe8,#e6eeebe0);border:1px solid #fff4d48c;box-shadow:0 3px 14px #244f6414}.seek-pill image{width:20px;height:20px}@keyframes seek-reveal{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}@keyframes listen-in{from{opacity:0}to{opacity:1}}
.sound-entry{position:absolute;inset:0;z-index:8;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,#4c497838,#183d5359);backdrop-filter:blur(8px);padding:24px;transition:opacity 3s ease,backdrop-filter 3s ease}.entry-card{text-align:center;width:340px;max-width:100%;transition:opacity .65s ease,transform 1.3s ease}.entry-mark{display:block;font-size:38px;margin-bottom:22px;color:#fff0c9}.entry-kicker{display:block;font-size:11px;letter-spacing:3px;opacity:.8;margin-bottom:22px}.entry-title{display:block;font-size:34px;line-height:1.5;letter-spacing:4px;font-weight:400;white-space:pre-line}.entry-description{display:block;font-size:14px;line-height:1.9;letter-spacing:2px;color:#f0ede8;margin:22px 0 34px;white-space:pre-line}
.enter-sound{display:inline-flex;align-items:center;justify-content:center;gap:10px;max-width:100%;min-height:49px;padding:10px 17px;border:1px solid #fff4d49c;border-radius:28px;background:linear-gradient(135deg,#fff5e4eb,#e7eeebe3);color:#355b64;font-size:14px;letter-spacing:.7px;box-shadow:0 5px 22px #234c621a}.entry-ripple{width:25px;height:25px;opacity:.85;flex-shrink:0}.entry-arrow{width:17px;height:17px;opacity:.65;flex-shrink:0}.enter-muted{display:block;margin:10px auto 0;min-height:44px;padding:10px 22px;font-size:12px;letter-spacing:1px;color:#efece6;opacity:.65}.entry-note{display:block;min-height:20px;font-size:12px;line-height:1.6;margin-top:8px;color:#fff0d6}.departing{opacity:0;backdrop-filter:blur(0);pointer-events:none}.departing .entry-card{opacity:0;transform:translateY(-12px)}.entering .header,.entering .score,.entering .hand-info,.entering .tutorial{animation:arrive-lakeside 3.2s ease both}@keyframes arrive-lakeside{0%,45%{opacity:0}100%{opacity:1}}
.dialog-backdrop{position:absolute;inset:0;background:#1e34586b;backdrop-filter:blur(9px);z-index:10;display:flex;align-items:center;justify-content:center;padding:15px}.settings-dialog{position:relative;background:#e8ece8;color:#254b5b;border:1px solid #fffcf0;border-radius:24px;width:440px;max-width:100%;padding:27px;box-shadow:0 30px 100px #16364a80}.dialog-scroll{max-height:75vh}.close{position:absolute;right:10px;top:10px;width:44px;height:44px;font-size:27px;z-index:1}.settings-title{display:block;font-size:24px;letter-spacing:3px;margin:10px 0 28px}.setting-row{display:flex;align-items:center;justify-content:space-between;font-size:16px;gap:15px}.setting-toggle{min-height:44px;padding:0 14px;border-radius:24px;background:#d2dedb;color:#264d59;font-size:14px;display:flex;align-items:center}.setting-toggle.enabled{background:#366775;color:white}.note{display:block;font-size:13px;line-height:1.85;color:#5d7580;margin:4px 0 22px}.details{border-top:1px solid #48677726;padding:5px 0}.summary{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:48px;font-size:15px;text-align:left}.paragraph{display:block;font-size:14px;line-height:1.85;margin:14px 0}.lake-guide{margin:18px 0 20px;padding:12px 10px 14px;background:#ffffff38;border:1px solid #ffffff70;border-radius:18px}.lake-guide image{display:block;width:100%}.lake-guide text{display:block;text-align:center;font-size:12px;line-height:1.8;color:#5d7580;white-space:pre-line}.source,.classic{display:block;min-height:44px;font-size:14px;text-align:left;color:#3c6978;text-decoration:underline;padding:12px 0}
.error-panel{position:absolute;left:24px;right:24px;bottom:35px;z-index:12;background:#e8ece8;color:#254b5b;padding:16px;text-align:center;border-radius:18px;font-size:14px;line-height:1.6}.error-panel button{min-height:48px;text-decoration:underline;margin-top:6px}
.reduced .sound-icon,.reduced .header,.reduced .score,.reduced .hand-info,.reduced .tutorial,.reduced .again,.reduced .listening{animation:none;transition:none}.reduced .sound-entry,.reduced .entry-card{transition:opacity .15s}
@media(max-width:350px){.gesture-options{gap:16px}.gesture-option{gap:5px}.gesture-option image{width:36px}.gesture-option text{font-size:12px}.enter-sound{font-size:13px;gap:8px;padding:10px 13px}}
@media(max-height:550px){.entry-mark,.entry-kicker{display:none}.entry-title{font-size:25px}.entry-description{margin:10px 0 18px}.entry-card{width:300px}.brand-cn{display:inline-block;margin-left:16px}.score{font-size:12px}.hand-info{left:auto;right:24px;width:230px;bottom:77px!important}.gesture-options{margin-top:10px}.listening{bottom:90px!important}.settings-dialog{padding:20px}.dialog-scroll{max-height:70vh}}
.dialog-scroll{height:75vh}
