.classic-page{position:fixed;inset:0;display:flex;flex-direction:column;padding-left:22px;padding-right:22px;background:#07090e;color:#e1e3ec}.header{height:78px;flex-shrink:0;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #232732}.wordmark{font-size:25px;font-weight:500;letter-spacing:-1.2px;display:flex;align-items:center;gap:12px;min-height:48px}.wordmark text{color:#858b9b;font-size:10px;font-weight:400;letter-spacing:2px}.edition,.label,.eyebrow{font-family:monospace;font-size:10px;letter-spacing:1.7px;color:#858b9b}.edition{font-size:8px;letter-spacing:1px;max-width:90px;line-height:1.6;text-align:right;white-space:pre-line}.instrument{flex:1;position:relative;min-height:180px}.instrument canvas{position:absolute;width:100%;height:100%}.intro{position:absolute;left:0;top:50%;transform:translateY(-50%);z-index:3;max-width:300px;padding:24px 0;background:linear-gradient(90deg,#07090e 80%,transparent)}.eyebrow{display:block;font-size:9px;letter-spacing:2px;margin-bottom:24px}.title{display:block;font-size:42px;line-height:1.14;letter-spacing:-2px;font-weight:400}.title.muted{color:#868b9e}.invitation{display:block;color:#a8acba;font-size:13px;letter-spacing:1.3px;margin:24px 0 32px}.start{border:1px solid #c1cba9;color:#d8e6bd;background:#07090e;display:flex;align-items:center;justify-content:space-between;padding:15px 19px;gap:68px;font-size:12px;letter-spacing:2px;min-height:48px}.start-note{display:block;font-size:10px;letter-spacing:.6px;color:#777e90;margin-top:17px}.top-left,.top-right{position:absolute;top:20px;pointer-events:none}.top-left{left:0;display:flex;flex-direction:column;gap:9px}.label{font-size:8px}.coordinates{color:#777e90;font-size:10px;font-family:monospace;letter-spacing:.5px}.top-right{right:0;display:flex;gap:8px;align-items:center;font-size:11px;color:#858b9b}.indicator{width:4px;height:4px;background:#555d70;border-radius:50%}.indicator.live{background:#d8e6bd}.caption{position:absolute;left:0;bottom:42px;pointer-events:none}.caption text{display:block;font-size:10px;color:#858b9b;margin-top:9px}.hint{position:absolute;bottom:18px;left:0;font-size:10px;color:#858b9b;pointer-events:none;letter-spacing:.3px}.error{position:absolute;top:70px;right:0;max-width:320px;font-size:12px;color:#ddbd85;z-index:4}.footer{border-top:1px solid #232732;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:16px 0;flex-shrink:0}.transport{display:flex;gap:10px;align-items:center}.play-control{width:48px;height:48px;border:1px solid #373d4a;border-radius:50%;font-size:11px}.transport>view{display:flex;flex-direction:column;gap:9px}.transport .label{font-size:9px;letter-spacing:1px}.transport-status{color:#b8bece;font-size:10px}.phrase{display:flex;gap:5px;align-items:flex-end;height:30px}.bar{width:3px;background:#3d4358}.bar.active{background:#d8e6bd}.footer-actions{display:flex;justify-content:space-between;width:100%}.footer-actions button{min-height:44px;font-size:10px;color:#9299aa}.backdrop{position:absolute;inset:0;background:#030408c4;z-index:8;display:flex;align-items:center;justify-content:center;padding:20px}.about{position:relative;max-width:500px;width:100%;padding:30px;background:#10131c;color:#e1e3ec;border:1px solid #363c4c}.about-scroll{max-height:70vh}.about text{display:block;font-size:13px;line-height:1.9;color:#afb5c5;margin:16px 0}.about .about-title{font-size:24px;color:#e1e3ec}.about button{min-height:44px;font-size:11px;color:#d8e6bd;text-align:left}.about .close{position:absolute;right:12px;top:10px;font-size:24px;width:44px;text-align:center}
@media(max-height:550px){.header{height:55px}.intro{padding:8px 0}.eyebrow,.start-note{display:none}.title{font-size:28px}.invitation{margin:10px 0}.footer{padding:8px 0;gap:6px}.footer-actions{width:auto;gap:12px}.top-left,.top-right{top:10px}}
.about-scroll{height:70vh}
